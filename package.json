{
  "name": "top",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "server": "pnpm --filter @top/server start --model openai/gpt-6.2-sol",
    "login": "pnpm --filter @top/server start login",
    "server:fake": "pnpm --filter @top/server start",
    "server:load": "pnpm --filter @top/server start --load --tools --seed 10000",
    "desktop": "pnpm --filter @top/desktop dev",
    "web": "pnpm --filter @top/desktop dev:web",
    "dev:fake": "node --import tsx scripts/dev-fake.ts",
    "bench": "pnpm --filter @top/desktop bench",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "biome check .",
    "fix": "biome check --write .",
    "wire": "node --import tsx scripts/wire.ts",
    "build:daemon": "node --import tsx scripts/build-daemon.ts",
    "build:desktop": "node --import tsx scripts/build-desktop.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@effect/language-service": "0.87.5",
    "@effect/tsgo": "0.67.1",
    "@types/node": "^24.19.2",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
